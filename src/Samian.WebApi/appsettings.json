{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "SamianDatabase": "Data Source=samian.db",
    "Redis": "localhost:6379,abortConnect=false"
  },

  "Jwt": {
    "Issuer": "Samian.WebApi",
    "Audience": "Samian.Clients",
    "SecretKey": "",
    "TokenLifetimeMinutes": 120
  },

  "Pricing": {
    "Strategy": "Volume",
    "DiscountRate": 0.05,
    "ThresholdAmount": 1000000
  }
}
