<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <!-- Application only: Domain arrives transitively. Infrastructure is the adapter layer, so the
         outermost technical concerns (EF Core, Redis, JWT) are allowed to live here and nowhere else. -->
    <ProjectReference Include="..\Samian.Application\Samian.Application.csproj" />
  </ItemGroup>

  <!-- Every version below exists in the offline NuGet cache (F:\.nuget\packages) and targets net8.0. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.5" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>    
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="9.0.5" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="9.0.5" />
    <!-- BackgroundService (OutboxWorker) lives here. Abstractions only, not the full Hosting meta-
         package: the worker is written by Infrastructure but REGISTERED by the host, so Infrastructure
         needs the base class, not the generic-host builder. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="9.0.8" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="9.0.5" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="7.5.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
